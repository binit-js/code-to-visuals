{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "paths": {
      "@/*": ["./src/*"],
      "cn": ["./src/lib/utils.ts"],
      "@animate-ui/react/primitives/cursor": ["./src/components/animate-ui/primitives/cursor/index.tsx"],
      "@animate-ui/react/primitives/effects/click": ["./src/components/animate-ui/primitives/effects/click/index.tsx"]
    },
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": ["src/tests"]
}
