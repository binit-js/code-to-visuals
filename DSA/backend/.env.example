# ========================================================
# CodeFlow Backend Configuration
# ========================================================

# Your personal or admin email address where you want feedback & complaints delivered:
ADMIN_EMAIL=binit.codeflow@gmail.com

# --------------------------------------------------------
# OPTION 1: SMTP Email Delivery (Gmail, Outlook, Hostinger, AWS SES)
# --------------------------------------------------------
# For Gmail:
# 1. Turn ON 2-Step Verification on your Google Account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an "App Password" named "CodeFlow"
# 4. Fill in SMTP_USER and SMTP_PASSWORD below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --------------------------------------------------------
# OPTION 2: Web3Forms Free API (Zero SMTP setup required)
# --------------------------------------------------------
# Get a free access key from https://web3forms.com and paste below:
WEB3FORMS_ACCESS_KEY=
